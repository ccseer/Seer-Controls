{
  "schema_version": 1,
  "id": "io.1218.seer.explorer-properties",
  "name": "Explorer Properties",
  "description": "Opens the Windows Properties dialog for the current file.",
  "version": "1.2.0",
  "appMinVersion": "4.8.0",
  "backend": "process",
  "capabilities": ["control"],
  "extensions": ["${type_file}"],
  "command": "shellverb_properties.exe",
  "arguments": ["--input", "${input_file}"],
  "close_after_success": false,
  "timeout_ms": 25000,
  "success_exit_codes": [0]
}
